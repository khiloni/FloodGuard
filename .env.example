# Copy to .env and edit. .env is git-ignored: never commit real keys.

# ---- Public address (Caddy gets the HTTPS certificate for it) ----
# No domain? Use sslip.io with the server's public IP, dots replaced by dashes:
#   SITE_ADDRESS=floodguard.203-0-113-10.sslip.io
SITE_ADDRESS=floodguard.203-0-113-10.sslip.io
# Optional: e-mail for Let's Encrypt expiry notices.
ACME_EMAIL=

# ---- App limits ----
MAX_INPUT_CHARS=400
RATE_LIMIT_PER_MIN=30

# ---- Language model (optional) ----
# template      = no AI; fixed template text (always works)
# openai_compat = an open model through an OpenAI-compatible API; falls back to templates on any error
LLM_MODE=template

# Which preset: sarvam | cloudflare | huggingface | ollama
LLM_PROVIDER=sarvam

# Keys: fill only the one for your provider.
SARVAM_API_KEY=
CF_ACCOUNT_ID=
CF_API_TOKEN=
HF_TOKEN=

# Advanced overrides (leave empty to use the preset). Only Apache-2.0 or MIT models are allowed.
LLM_BASE_URL=
LLM_MODEL=

# Local model on the same server (with: docker compose --profile local-llm up -d):
#   LLM_MODE=openai_compat
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://ollama:11434/v1
